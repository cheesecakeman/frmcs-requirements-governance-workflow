    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst reqs = items.map(item => {\n  const clean = {};\n  Object.keys(item.json).forEach(k => {\n    clean[k.replace(/^\\uFEFF/, '').trim()] = typeof item.json[k] === 'string' ? item.json[k].trim() : item.json[k];\n  });\n  return {\n    id: clean.id || '',\n    text: clean.text || '',\n    sourceDoc: clean.sourceDoc || '',\n    sourceSection: clean.sourceSection || '',\n    sourceRef: clean.sourceRef || null,\n    stakeholderType: clean.stakeholderType || '',\n    abstractionLevel: clean.abstractionLevel || '',\n    ambiguityFlag: clean.ambiguityFlag || 'no',\n    clarifiedText: clean.clarifiedText || '',\n    comparisonNote: clean.comparisonNote || '',\n    mismatchFlag: clean.mismatchFlag || 'no',\n    stricterSource: clean.stricterSource || 'n/a',\n    openQuestion: clean.openQuestion || null,\n    reviewStatus: clean.reviewStatus || 'ok'\n  };\n});\n\nreturn [{ json: { allRequirements: JSON.stringify(reqs) } }];"
      },
