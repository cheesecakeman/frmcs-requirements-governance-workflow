      "parameters": {
        "jsCode": "const allItems = $input.all();\nlet requirements = [];\nlet specText = '';\n\nfor (const item of allItems) {\n  const keys = Object.keys(item.json);\n  \n  if ('sourceDoc' in item.json) {\n    const idKey = keys.find(k => k.replace(/^\\uFEFF/, '') === 'id');\n    const id = idKey ? item.json[idKey] : null;\n    if (id) {\n      requirements.push({\n        id: id,\n        text: item.json.text || '',\n        sourcePassage: item.json.sourcePassage || '',\n        sourceDoc: item.json.sourceDoc || '',\n        sourceSection: item.json.sourceSection || '',\n        sourceRef: item.json.sourceRef || null,\n        stakeholderType: item.json.stakeholderType || '',\n        abstractionLevel: item.json.abstractionLevel || '',\n        ambiguityFlag: item.json.ambiguityFlag || 'no'\n      });\n    }\n  } else if (item.json.text) {\n    specText += ' ' + item.json.text;\n  }\n}\n\n// Filter to requirements with explicit 10.11 sourceRef\nconst withRef = requirements.filter(r =>\n  r.sourceRef && String(r.sourceRef).includes('10.11')\n);\nconst filtered = withRef.length >= 10\n  ? withRef.slice(0, 10)\n  : requirements.slice(0, 10);\n\n// Skip preamble and take substantive content\nconst markers = ['5 SYSTEM ARCHITECTURE', '4 INTRODUCTION', '7.1.2', '45 / 202'];\nlet start = 0;\nfor (const m of markers) {\n  const idx = specText.indexOf(m);\n  if (idx > 0) { start = idx; break; }\n}\nconst trimmedSpec = specText.slice(start, start + 12000);\n\nconst prompt = `You are a requirements comparison and clarification agent for railway engineering documents (GSM-R to FRMCS migration context).\n\nFor each requirement below, return a JSON object with exactly these 7 fields:\n- \"id\": the original id unchanged\n- \"clarifiedText\": clarified version or original if already clear\n- \"comparisonNote\": one sentence on how this requirement relates to the reference spec\n- \"mismatchFlag\": \"yes\" if conflict or inconsistency, else \"no\"\n- \"stricterSource\": \"input\", \"spec\", \"equal\", or \"n/a\"\n- \"openQuestion\": one unresolved question needing human judgment, or null\n- \"reviewStatus\": \"ok\", \"needs review\", or \"conflict\"\n\nReturn ONLY a JSON array. Start with [ and end with ]\nNo explanation, no markdown fences.\n\nRequirements:\n${JSON.stringify(filtered)}\n\nReference specification:\n${trimmedSpec}`;\n\nreturn [{\n  json: {\n    requirements: JSON.stringify(filtered),\n    specText: trimmedSpec,\n    prompt: prompt\n  }\n}];"
      },
