        "jsCode": "const first = $input.first().json;\nconst text = first?.output?.[0]?.content?.[0]?.text || '';\nconst content = text.replace(/```json|```/g, '').trim();\n\nlet reqArray = [];\ntry {\n  const parsed = JSON.parse(content);\n  reqArray = Array.isArray(parsed) ? parsed : [parsed];\n} catch(e) {\n  return [{ json: { error: e.message, raw: content.slice(0, 300) } }];\n}\n\nreturn reqArray.map(r => ({ json: r }));"
      },
